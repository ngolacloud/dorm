UPDATE "deployments" SET "status" = $1, "updated_at" = now() WHERE "id" IN (SELECT "deployments"."id" FROM "deployments" WHERE "deployments"."id" = $2)

-- parameters, in binding order:
--   $1 = Text("running")
--   $2 = I64(1)
