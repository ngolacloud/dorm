---
source: crates/dorm-models/tests/sql_snapshots.rs
expression: "select(Tenant::objects().filter_str(\"apps__deployments__status\", \"running\"))"
---
SELECT "tenants"."id", "tenants"."slug", "tenants"."name", "tenants"."created_at" FROM "tenants" LEFT JOIN "applications" AS "j_apps" ON "tenants"."id" = "j_apps"."tenant" LEFT JOIN "deployments" AS "j_apps__deployments" ON "j_apps"."id" = "j_apps__deployments"."app" WHERE "j_apps__deployments"."status" = $1 ORDER BY "tenants"."created_at" DESC

-- parameters, in binding order:
--   $1 = Text("running")
-- result columns:
--   id : I64
--   slug : Text
--   name : Text
--   created_at : Timestamp
