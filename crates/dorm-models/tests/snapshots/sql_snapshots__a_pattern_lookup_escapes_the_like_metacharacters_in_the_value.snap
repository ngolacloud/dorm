---
source: crates/dorm-models/tests/sql_snapshots.rs
expression: "select(Tenant::objects().filter(tenant::name.contains(\"50% _off\")))"
---
SELECT "tenants"."id", "tenants"."slug", "tenants"."name", "tenants"."created_at" FROM "tenants" WHERE "tenants"."name" LIKE $1 ORDER BY "tenants"."created_at" DESC

-- parameters, in binding order:
--   $1 = Text("%50\\% \\_off%")
-- result columns:
--   id : I64
--   slug : Text
--   name : Text
--   created_at : Timestamp
