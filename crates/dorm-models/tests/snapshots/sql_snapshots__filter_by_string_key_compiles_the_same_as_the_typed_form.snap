source: crates/dorm-models/tests/sql_snapshots.rs
expression: dynamic
---
SELECT "tenants"."id", "tenants"."slug", "tenants"."name", "tenants"."created_at" FROM "tenants" WHERE "tenants"."name" ILIKE $1 ORDER BY "tenants"."created_at" DESC

-- parameters, in binding order:
--   $1 = Text("%ac%")
-- result columns:
--   id : I64
--   slug : Text
--   name : Text
--   created_at : Timestamp
