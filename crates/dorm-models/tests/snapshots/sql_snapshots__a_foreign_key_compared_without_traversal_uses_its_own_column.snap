---
source: crates/dorm-models/tests/sql_snapshots.rs
expression: "select(Deployment::objects().filter(deployment::app.eq(Value::I64(7))))"
---
SELECT "deployments"."id", "deployments"."app", "deployments"."replicas", "deployments"."status", "deployments"."config", "deployments"."created_at", "deployments"."updated_at" FROM "deployments" WHERE "deployments"."app" = $1 ORDER BY "deployments"."created_at" DESC

-- parameters, in binding order:
--   $1 = I64(7)
-- result columns:
--   id : I64
--   app : I64
--   replicas : I64
--   status : Text
--   config : Json
--   created_at : Timestamp
--   updated_at : Timestamp
