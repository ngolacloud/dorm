UPDATE "deployments" SET "replicas" = ("replicas" + $1), "updated_at" = now() WHERE "id" IN (SELECT "deployments"."id" FROM "deployments" WHERE "deployments"."app" = $2)

-- parameters, in binding order:
--   $1 = I64(1)
--   $2 = I64(7)
