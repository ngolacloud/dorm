---
source: crates/dorm-models/tests/sql_snapshots.rs
expression: "select(Deployment::objects().filter(deployment::app.tenant().slug().eq(\"acme\")))"
---
SELECT "deployments"."id", "deployments"."app", "deployments"."replicas", "deployments"."status", "deployments"."config", "deployments"."created_at", "deployments"."updated_at" FROM "deployments" LEFT JOIN "applications" AS "j_app" ON "deployments"."app" = "j_app"."id" LEFT JOIN "tenants" AS "j_app__tenant" ON "j_app"."tenant" = "j_app__tenant"."id" WHERE "j_app__tenant"."slug" = $1 ORDER BY "deployments"."created_at" DESC

-- parameters, in binding order:
--   $1 = Text("acme")
-- result columns:
--   id : I64
--   app : I64
--   replicas : I64
--   status : Text
--   config : Json
--   created_at : Timestamp
--   updated_at : Timestamp
