expression: render(&sql)
---
SELECT COUNT(*) FROM (SELECT "tenants"."id", "tenants"."slug", "tenants"."name", "tenants"."created_at", COUNT(DISTINCT "r_apps"."id") AS "n" FROM "tenants" LEFT JOIN "applications" AS "r_apps" ON "tenants"."id" = "r_apps"."tenant" GROUP BY "tenants"."id" ORDER BY "tenants"."created_at" DESC) AS _c

-- no parameters
-- result columns:
--   count : I64
