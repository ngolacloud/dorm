---
source: crates/dorm-models/tests/sql_snapshots.rs
expression: select(qs)
---
SELECT "tenants"."id", "tenants"."slug", "tenants"."name", "tenants"."created_at", COUNT(DISTINCT "r_apps"."id") AS "n" FROM "tenants" LEFT JOIN "applications" AS "r_apps" ON "tenants"."id" = "r_apps"."tenant" GROUP BY "tenants"."id" ORDER BY "tenants"."created_at" DESC

-- no parameters
-- result columns:
--   id : I64
--   slug : Text
--   name : Text
--   created_at : Timestamp
--   n : I64
