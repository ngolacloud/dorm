---
source: crates/dorm-models/tests/sql_snapshots.rs
expression: "select(Tenant::objects().exclude(tenant::slug.eq(\"acme\") &\ntenant::name.eq(\"ACME Lda\")))"
---
SELECT "tenants"."id", "tenants"."slug", "tenants"."name", "tenants"."created_at" FROM "tenants" WHERE NOT (("tenants"."slug" = $1 AND "tenants"."name" = $2)) ORDER BY "tenants"."created_at" DESC

-- parameters, in binding order:
--   $1 = Text("acme")
--   $2 = Text("ACME Lda")
-- result columns:
--   id : I64
--   slug : Text
--   name : Text
--   created_at : Timestamp
