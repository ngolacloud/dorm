SELECT EXISTS (SELECT 1 FROM (SELECT "applications"."id", "applications"."tenant", "applications"."plan", "applications"."name", "applications"."created_at" FROM "applications" WHERE "applications"."name" = $1 LIMIT 1) AS _e)

