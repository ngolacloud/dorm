DELETE FROM "applications" WHERE "id" IN (SELECT "applications"."id" FROM "applications" LEFT JOIN "tenants" AS "j_tenant" ON "applications"."tenant" = "j_tenant"."id" WHERE "j_tenant"."slug" = $1)

